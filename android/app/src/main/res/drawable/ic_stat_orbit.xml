<?xml version="1.0" encoding="utf-8"?>
<!--
  Icône de notification (barre d'état Android).

  DOIT rester une silhouette monochrome blanche : Android compose l'icône de
  notification à partir du canal ALPHA et ignore les couleurs. Réutiliser
  l'icône de launcher (colorée, adaptative) donnerait une pastille illisible.

  C'est aussi la seule façon d'obtenir un `drawable` : l'icône de launcher vit
  dans `mipmap/`, et flutter_local_notifications résout le nom de ressource par
  getIdentifier(nom, "drawable", package) — un `@mipmap/ic_launcher` n'est donc
  jamais trouvé, d'où :
  PlatformException(invalid_icon, The resource @mipmap/ic_launcher could not be
  found).

  L'anneau est un seul chemin `evenOdd` (ellipse extérieure + ellipse
  intérieure) : le trou est réel, donc la planète reste visible au travers.
  Peindre l'intérieur en noir ne suffirait pas — le noir est opaque, Android le
  garderait.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Disque de la planète, dessous. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,4.5m-6.1,0a6.1,6.1 0 1,0 12.2,0a6.1,6.1 0 1,0 -12.2,0z" />
    <!-- Anneau orbital : anneau creux (evenOdd). -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,4.5m-9.5,0a9.5,3.3 0 1,0 19,0a9.5,3.3 0 1,0 -19,0zM12,4.5m-8.1,0a8.1,1.1 0 1,0 16.2,0a8.1,1.1 0 1,0 -16.2,0z" />
</vector>
