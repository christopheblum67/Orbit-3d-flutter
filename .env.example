# Xtream Codes API
XTREAM_BASE_URL=https://your-provider.com
XTREAM_USERNAME=your_username
XTREAM_PASSWORD=your_password

# M3U URL (optionnel)
M3U_URL=https://your-m3u-url.com/playlist.m3u

# IA API (ex: OpenAI, Gemini, Ollama)
IA_API_KEY=your_ia_api_key
IA_API_ENDPOINT=https://api.openai.com/v1/chat/completions

# TMDB API (TheMovieDB) - Pour métadonnées films/séries et classements de l'onglet FlixPatrol
# Obtenir une clé sur https://www.themoviedb.org/settings/api
# Option A : clé partagée embarquée + override par utilisateur dans Réglages
# (Réglages → Contenu → Clé API TMDB), en plus de cette valeur de build.
TMDB_API_KEY=your_tmdb_api_key

# OMDB API (Open Movie Database) - Fallback année/runtime/rating
# Obtenir une clé sur http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key

# TVmaze API - Pas de clé nécessaire (gratuit, rate limited)

# VPN
VPN_CONFIG_PATH=